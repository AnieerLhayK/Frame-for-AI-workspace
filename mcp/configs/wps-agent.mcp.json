{
  "mcpServers": {
    "wps-agent": {
      "command": "${DATA_ROOT}\\mcp\\wps-agent\\.venv\\Scripts\\python.exe",
      "args": [
        "${DATA_ROOT}\\mcp\\wps-agent\\source\\mcp_server.py"
      ],
      "cwd": "${DATA_ROOT}\\mcp\\wps-agent\\source",
      "env": {
        "PYTHONUTF8": "1",
        "WPS_AGENT_LOG_DIR": "${DATA_ROOT}\\workspace\\logs\\wps-agent"
      }
    }
  }
}
