{
  "mcpServers": {
    "wps-agent": {
      "command": "${DATA_ROOT}\\mcp\\wps-agent\\.venv\\Scripts\\python.exe",
      "args": [
        "${DATA_ROOT}\\mcp\\wps-agent\\source\\mcp_server.py"
      ],
      "cwd": "${DATA_ROOT}\\mcp\\wps-agent\\source",
      "env": {
        "PYTHONUTF8": "1",
        "WPS_AGENT_LOG_DIR": "${DATA_ROOT}\\workspace\\logs\\wps-agent"
      }
    },
    "filesystem": {
      "command": "${DATA_ROOT}\\mcp\\node\\node_modules\\.bin\\mcp-server-filesystem.cmd",
      "args": [
        "${WORKSPACE_ROOT}",
        "${DEV_ROOT}"
      ]
    },
    "memory": {
      "command": "${DATA_ROOT}\\mcp\\node\\node_modules\\.bin\\mcp-server-memory.cmd",
      "env": {
        "MEMORY_FILE_PATH": "${DATA_ROOT}\\mcp\\state\\memory\\memory.jsonl"
      }
    },
    "sequential-thinking": {
      "command": "${DATA_ROOT}\\mcp\\node\\node_modules\\.bin\\mcp-server-sequential-thinking.cmd"
    },
    "playwright": {
      "command": "${DATA_ROOT}\\mcp\\node\\node_modules\\.bin\\playwright-mcp.cmd",
      "args": [
        "--browser",
        "msedge",
        "--output-dir",
        "${DATA_ROOT}/playwright-mcp\\default"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "${DATA_ROOT}/playwright-browsers"
      }
    },
    "context7": {
      "command": "${DATA_ROOT}\\mcp\\node\\node_modules\\.bin\\context7-mcp.cmd"
    },
    "hermes": {
      "command": "${DATA_ROOT}/hermes\\hermes-agent\\venv\\Scripts\\hermes.exe",
      "args": [
        "mcp",
        "serve"
      ]
    }
  }
}
