{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package_catalog.schema.json",
  "title": "Workspace package-owned assets catalog",
  "type": "object",
  "required": ["schema_version", "package_id", "skills", "tools"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_path", "status", "workspace_registered"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "development", "retired"]},
          "workspace_registered": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entrypoint", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
